{
  "compilerOptions": {
    "esModuleInterop": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "allowJs": true,
    "resolveJsonModule": true,
    "moduleDetection": "force",
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "module": "preserve",
    "baseUrl": ".",
    "paths": {
      "@city/classicyui": ["packages/classicyui/src/index.ts"],
      "@city/core-bridge": ["packages/core-bridge/src/index.ts"],
      "@city/sim-integration": ["packages/sim-integration/src/index.ts"]
    },
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "lib": ["ES2022"],
    "allowImportingTsExtensions": true,
    "forceConsistentCasingInFileNames": true
  }
}
